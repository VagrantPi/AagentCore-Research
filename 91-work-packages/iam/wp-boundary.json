{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MaxForAgentCoreExecutionAndTestRoles",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel*", "bedrock:Converse*", "bedrock:ApplyGuardrail",
        "bedrock-agentcore:*",
        "logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents",
        "xray:PutTraceSegments", "xray:PutTelemetryRecords", "cloudwatch:PutMetricData",
        "ecr:GetAuthorizationToken", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer",
        "s3:GetObject", "s3:PutObject", "s3:ListBucket",
        "dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query", "dynamodb:DeleteItem"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoIamFromInside",
      "Effect": "Deny",
      "Action": ["iam:*", "organizations:*", "account:*"],
      "Resource": "*"
    }
  ]
}
